---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile, experience } from '../data/cv.js';
---

<Layout title={`Experiencia | ${profile.name}`} description={profile.summary}>
  <Nav current="experience" />

  <section class="flex-1 pt-32 pb-24 bg-slate-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-3 text-blue-400 font-semibold text-sm uppercase tracking-wider mb-5">
          <div class="w-8 h-0.5 bg-blue-400"></div>
          Trayectoria Profesional
          <div class="w-8 h-0.5 bg-blue-400"></div>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Experiencia Profesional</h2>
        <p class="text-slate-400 max-w-xl mx-auto">
          {profile.yearsExperience} años liderando tecnología empresarial en el sector financiero y de gestión de activos
        </p>
      </div>

      <div class="relative">
        <div class="absolute left-5 top-0 bottom-0 w-px bg-slate-700"></div>

        <div class="flex flex-col gap-5">
          {experience.map((item) => (
            <div class="relative flex gap-6 items-start">
              <div class:list={[
                'relative z-10 flex-shrink-0 w-10 h-10 rounded-full border-4 border-slate-900 shadow-md flex items-center justify-center mt-1',
                item.current ? 'bg-blue-600' : 'bg-slate-600',
              ]}>
                {item.current && <div class="w-2.5 h-2.5 bg-white rounded-full" />}
              </div>

              <div class="flex-1 bg-slate-800/60 rounded-2xl border border-slate-700 hover:border-blue-500 hover:shadow-md transition-all overflow-hidden">
                <details class="group">
                  <summary class="cursor-pointer p-5 flex items-start justify-between gap-4 list-none select-none">
                    <div class="flex-1 min-w-0">
                      <div class="flex flex-wrap items-center gap-2 mb-1">
                        <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">{item.period}</span>
                        {item.current && (
                          <span class="bg-blue-500/20 text-blue-300 text-xs font-semibold px-2 py-0.5 rounded-full">Actual</span>
                        )}
                      </div>
                      <h3 class="font-bold text-white">{item.role}</h3>
                      <p class="text-blue-400 font-semibold text-sm">{item.company}</p>
                      <p class="text-slate-500 text-xs mt-0.5">{item.location}</p>
                    </div>
                    <svg class="w-5 h-5 text-slate-500 mt-1 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </summary>

                  <div class="px-5 pb-5 border-t border-slate-700 pt-4">
                    <ul class="flex flex-col gap-2.5">
                      {item.details.map((detail) => (
                        <li class="flex items-start gap-2.5 text-slate-300 text-sm leading-relaxed">
                          <div class="w-4 h-4 bg-blue-500/20 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-2.5 h-2.5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                          </div>
                          {detail}
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
