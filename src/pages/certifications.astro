---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile, certifications } from '../data/cv.js';
---

<Layout title={`Formación Ejecutiva | ${profile.name}`} description={profile.summary}>
  <Nav current="certifications" />

  <section class="flex-1 pt-32 pb-24 bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-3 text-blue-400 font-semibold text-sm uppercase tracking-wider mb-5">
          <div class="w-8 h-0.5 bg-blue-400"></div>
          Credenciales
          <div class="w-8 h-0.5 bg-blue-400"></div>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Formación Ejecutiva</h2>
        <p class="text-slate-400 max-w-xl mx-auto">Programas de liderazgo y desarrollo ejecutivo</p>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-5">
        {certifications.map((cert) => (
          <div class="bg-slate-800/50 rounded-2xl p-6 border border-slate-700 hover:border-blue-500 hover:shadow-lg transition-all flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 bg-blue-600">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
            </div>
            <div>
              <div class="font-black text-white text-lg">{cert.name}</div>
              <div class="text-slate-300 text-sm font-medium">{cert.full}</div>
              <div class="text-blue-400 text-xs font-semibold mt-1">{cert.org}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
