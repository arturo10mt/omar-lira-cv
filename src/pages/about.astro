---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile, coreAttributes, organizations, education } from '../data/cv.js';
---

<Layout title={`Sobre Mí | ${profile.name}`} description={profile.summary}>
  <Nav current="about" />

  <section class="flex-1 pt-32 pb-24 bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-16 items-start">
        <!-- Left: About text (3 cols) -->
        <div class="lg:col-span-3">
          <div class="inline-flex items-center gap-3 text-blue-400 font-semibold text-sm uppercase tracking-wider mb-5">
            <div class="w-8 h-0.5 bg-blue-400"></div>
            Sobre Mí
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6 leading-tight">
            Alineando la Estrategia Tecnológica con los Objetivos del Negocio
          </h2>
          <p class="text-slate-300 text-lg leading-relaxed mb-8">
            {profile.summary}
          </p>

          <div class="grid grid-cols-2 gap-3 mb-10">
            {coreAttributes.map((attr) => (
              <div class="flex items-center gap-2.5 text-slate-300">
                <div class="w-5 h-5 bg-blue-500/20 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg class="w-3 h-3 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <span class="text-sm font-medium">{attr}</span>
              </div>
            ))}
          </div>

          <!-- Languages -->
          <div class="mb-10">
            <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider mb-4">Idiomas</p>
            <div class="flex flex-col gap-3 max-w-sm">
              {profile.languages.map((l) => (
                <div>
                  <div class="flex justify-between items-center mb-1">
                    <span class="text-sm font-semibold text-slate-200">{l.lang}</span>
                    <span class="text-xs text-slate-500">{l.level}</span>
                  </div>
                  <div class="h-1.5 bg-slate-800 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-500 rounded-full" style={`width: ${l.bar}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Eventos y proveedores -->
          <div>
            <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider mb-4">Foros y Negociaciones Estratégicas</p>
            <p class="text-slate-300 leading-relaxed">
              Asiste regularmente a foros como Gartner IT Symposium/Xpo, HPE Discovery, IBM Think, Salesforce
              Dreamforce, BlackHat, RSA y DEFCON. Ha liderado negociaciones estratégicas y regionales con más
              de 80 partners y canales tecnológicos globales, incluyendo Microsoft, IBM, HPE, AWS, Google/GCP,
              Salesforce, Gartner y Forrester.
            </p>
          </div>
        </div>

        <!-- Right: Side cards (2 cols) -->
        <div class="lg:col-span-2 flex flex-col gap-5">
          <!-- Organizations -->
          <div class="bg-slate-800/50 rounded-2xl p-6 border border-slate-700">
            <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider mb-4">Organizaciones Clave</p>
            <div class="grid grid-cols-2 gap-2.5">
              {organizations.map((company) => (
                <div class="bg-slate-900/60 rounded-xl p-3 text-center border border-slate-700 hover:border-blue-500 hover:shadow-sm transition-all">
                  <span class="font-bold text-slate-200 text-sm">{company}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Education -->
          <div class="bg-slate-800/50 rounded-2xl p-6 border border-slate-700">
            <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider mb-4">Educación</p>
            <div class="flex flex-col gap-4">
              {education.map((e, i) => (
                <div class:list={[i > 0 && 'border-t border-slate-700 pt-3']}>
                  <div class="font-semibold text-white text-sm">{e.degree}</div>
                  <div class="text-slate-400 text-xs">{e.school}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- Connect links -->
          <div class="bg-slate-800/50 rounded-2xl p-6 border border-slate-700">
            <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider mb-4">Conecta</p>
            <div class="flex flex-col gap-3">
              <a href={profile.linkedIn} target="_blank" rel="noopener"
                 class="flex items-center gap-3 text-slate-300 hover:text-blue-400 transition-colors group">
                <div class="w-8 h-8 bg-[#0077b5]/10 rounded-lg flex items-center justify-center group-hover:bg-[#0077b5]/20 transition-colors">
                  <svg class="w-4 h-4 text-[#0077b5]" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </div>
                <span class="text-sm font-medium">omarlira77</span>
              </a>
              <a href={`mailto:${profile.email}`}
                 class="flex items-center gap-3 text-slate-300 hover:text-blue-400 transition-colors group">
                <div class="w-8 h-8 bg-slate-700 rounded-lg flex items-center justify-center group-hover:bg-blue-500/20 transition-colors">
                  <svg class="w-4 h-4 text-slate-300 group-hover:text-blue-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <span class="text-sm font-medium">{profile.email}</span>
              </a>
              <a href={profile.whatsappUrl} target="_blank" rel="noopener"
                 class="flex items-center gap-3 text-slate-300 hover:text-green-400 transition-colors group">
                <div class="w-8 h-8 bg-green-500/10 rounded-lg flex items-center justify-center group-hover:bg-green-500/20 transition-colors">
                  <svg class="w-4 h-4 text-green-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <span class="text-sm font-medium">WhatsApp · {profile.phonePrimary}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
