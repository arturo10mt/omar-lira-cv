---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile, heroStats } from '../data/cv.js';
---

<Layout>
  <Nav current="home" />

  <!-- ========== HERO ========== -->
  <section class="relative min-h-screen bg-slate-900 flex items-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-900 to-blue-950"></div>
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="absolute top-1/4 right-0 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 left-0 w-64 h-64 bg-slate-500/10 rounded-full blur-3xl"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Text -->
        <div>
          <div class="inline-flex items-center gap-2 bg-blue-600/20 border border-blue-500/30 rounded-full px-4 py-1.5 mb-8">
            <div class="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></div>
            <span class="text-blue-300 text-sm font-medium">{profile.availability}</span>
          </div>

          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-white mb-4 leading-[1.1] tracking-tight">
            Omar<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-slate-300 to-sky-400">
              Lira Rangel
            </span>
          </h1>

          <h2 class="text-lg sm:text-xl font-medium text-slate-300 mb-3 leading-relaxed">
            {profile.tagline}
          </h2>

          <p class="text-slate-400 text-base mb-8 leading-relaxed">
            {profile.summary}
          </p>

          <div class="flex flex-wrap gap-3 mb-10">
            <a href={`mailto:${profile.email}`} class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-xl transition-all hover:shadow-xl hover:shadow-blue-600/25">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Contáctame
            </a>
            <a href={profile.linkedIn} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-[#0077b5] hover:bg-[#006097] text-white font-semibold px-6 py-3 rounded-xl transition-all">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
            <a href="/experience" class="inline-flex items-center gap-2 border border-slate-600 hover:border-slate-400 text-slate-300 hover:text-white font-semibold px-6 py-3 rounded-xl transition-all">
              Ver Experiencia
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {heroStats.map((stat) => (
              <div class="border border-slate-700/50 rounded-xl p-3 bg-slate-800/40">
                <div class="text-2xl font-black text-white mb-0.5">{stat.value}</div>
                <div class="text-slate-400 text-xs">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Avatar/Photo -->
        <div class="hidden lg:flex flex-col items-center gap-6">
          <div class="relative">
            <img
              src="/omar.png"
              alt={profile.name}
              class="w-56 h-56 rounded-full object-cover object-top shadow-2xl shadow-blue-500/30 border-4 border-slate-700"
            />
            <div class="absolute -bottom-2 -right-2 bg-blue-600 rounded-full p-2.5 border-2 border-slate-900 shadow-lg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
            </div>
          </div>

          <div class="flex flex-col gap-2 items-center">
            <div class="flex items-center gap-2 text-slate-400 text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              {profile.locations}
            </div>
            <div class="flex items-center gap-2 text-slate-400 text-sm">
              <span class="text-slate-500">Disponible para</span>
              <span class="text-blue-400 font-medium">Remoto · Híbrido · Presencial</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
      <div class="w-5 h-8 border-2 border-slate-700 rounded-full flex items-start justify-center p-1">
        <div class="w-1 h-2 bg-slate-600 rounded-full animate-bounce"></div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
