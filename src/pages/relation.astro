---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/cv.js';
---

<Layout title={`Foros y Negociaciones | ${profile.name}`} description={profile.summary}>
  <Nav current="relation" />

  <section class="flex-1 pt-32 pb-24 bg-slate-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-3 text-blue-400 font-semibold text-sm uppercase tracking-wider mb-5">
          <div class="w-8 h-0.5 bg-blue-400"></div>
          Relacionamiento
          <div class="w-8 h-0.5 bg-blue-400"></div>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Asistencia a Eventos.</h2>
        <p class="text-slate-400 max-w-xl mx-auto">
          Asistencia activa desde 2006 a eventos relevantes de la industria tecnológica.
        </p>
      </div>

      <img
        src="/asistencia_eventos.jpg"
        alt="Logos de eventos: Black Hat, HPE Discover, RSA Conference, IBM Think, DEFCON, Gartner IT Symposium/Xpo, Gartner, Dreamforce"
        class="w-full rounded-2xl border border-slate-700 mb-20"
      />

      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Fabricantes y servicios.</h2>
        <p class="text-slate-400 max-w-2xl mx-auto">
          Relacionamiento y negociaciones con más de 80 marcas y proveedores de servicios líderes de la cadena de suministro de la industria
        </p>
      </div>

      <img
        src="/relacionamiento.jpg"
        alt="Logos de fabricantes y proveedores: Microsoft, IBM, HPE, AWS, Google, Salesforce, Gartner, Telmex, Kyndryl, Cisco, Red Hat"
        class="w-full rounded-2xl border border-slate-700"
      />
    </div>
  </section>

  <Footer />
</Layout>
