---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile, competencyGroups } from '../data/cv.js';
---

<Layout title={`Habilidades | ${profile.name}`} description={profile.summary}>
  <Nav current="skills" />

  <section class="flex-1 pt-32 pb-24 bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-3 text-blue-400 font-semibold text-sm uppercase tracking-wider mb-5">
          <div class="w-8 h-0.5 bg-blue-400"></div>
          Especialidad
          <div class="w-8 h-0.5 bg-blue-400"></div>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Métodos y Marcos de Referencia</h2>
        <p class="text-slate-400 max-w-xl mx-auto">Frameworks y competencias desarrolladas a lo largo de {profile.yearsExperience} años de liderazgo tecnológico</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {competencyGroups.map((group) => (
          <div class="bg-slate-800/50 rounded-2xl p-8 border border-slate-700">
            <div class="flex items-center gap-3 mb-6">
              <span class="text-2xl">{group.icon}</span>
              <h3 class="font-bold text-white">{group.category}</h3>
            </div>
            <ul class="flex flex-col gap-3">
              {group.skills.map((skill) => (
                <li class="flex items-start gap-2.5 text-slate-300 text-sm leading-relaxed">
                  <div class="w-4 h-4 bg-blue-500/20 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
