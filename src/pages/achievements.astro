---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile, achievements } from '../data/cv.js';
---

<Layout title={`Logros | ${profile.name}`} description={profile.summary}>
  <Nav current="achievements" />

  <section class="flex-1 pt-32 pb-24 bg-slate-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-3 text-blue-400 font-semibold text-sm uppercase tracking-wider mb-5">
          <div class="w-8 h-0.5 bg-blue-400"></div>
          Impacto
          <div class="w-8 h-0.5 bg-blue-400"></div>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Logros Clave</h2>
        <p class="text-slate-400 max-w-xl mx-auto">Resultados cuantificados entregados a través de programas y organizaciones</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-5">
        {achievements.map((item) => (
          <div class={`bg-gradient-to-br ${item.color} rounded-2xl p-5 sm:p-7 text-white`}>
            <div class="text-3xl sm:text-4xl md:text-5xl font-black mb-3 tracking-tight break-words">{item.metric}</div>
            <div class="font-semibold text-white/90 mb-1.5 leading-tight">{item.label}</div>
            <div class="text-white/55 text-sm">{item.context}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
