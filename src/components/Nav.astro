---
import { profile } from '../data/cv.js';

interface Props {
  current?: string;
}
const { current = '' } = Astro.props;

const links = [
  { href: '/', label: 'Inicio', key: 'home' },
  { href: '/about', label: 'Sobre Mí', key: 'about' },
  { href: '/experience', label: 'Experiencia', key: 'experience' },
  { href: '/achievements', label: 'Logros', key: 'achievements' },
  { href: '/skills', label: 'Habilidades', key: 'skills' },
  { href: '/certifications', label: 'Formación Ejecutiva', key: 'certifications' },
  { href: '/contact', label: 'Contacto', key: 'contact' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur-sm border-b border-slate-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5">
        <img src="/omar.png" alt={profile.name} class="w-8 h-8 rounded-full object-cover object-top flex-shrink-0 ring-2 ring-blue-500/40" />
        <span class="text-white font-semibold text-sm">{profile.name}</span>
      </a>

      <div class="hidden lg:flex items-center gap-5">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors',
              current === link.key ? 'text-white' : 'text-slate-400 hover:text-white',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a href={profile.cvPdf} download class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors whitespace-nowrap">
          Descargar CV
        </a>
      </div>

      <button id="menu-btn" class="lg:hidden text-slate-400 hover:text-white p-1" aria-label="Menú">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden pb-4 pt-3 border-t border-slate-800">
      <div class="flex flex-col gap-3">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium',
              current === link.key ? 'text-white' : 'text-slate-300 hover:text-white',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a href={profile.cvPdf} download class="text-blue-400 hover:text-blue-300 text-sm font-medium">Descargar CV</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
  });
</script>
